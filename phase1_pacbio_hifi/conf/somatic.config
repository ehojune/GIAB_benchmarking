/*
 * 70_submit_somatic.sh 전용 사이트 설정 — kobic.config 뒤에 -c 로 얹는다.
 *
 * 파이프라인(bioinfo-agent 0.2.0)은 DEEPSOMATIC 을 label 'process_high' = 16 CPU 로 선언한다.
 * kobic.config 의 resourceLimits 는 잡 슬롯보다 **클 때 줄이기만** 해서, 잡에 60 슬롯을 줘도
 * DeepSomatic 은 16 shard 로 돈다(--num_shards=${task.cpus}). 이 잡에는 무거운 process 가 그것 하나뿐이라
 * 잡 슬롯 전부를 준다. 파이프라인 코드는 고치지 않는다(범용 코드는 bioinfo-agent 몫).
 */
def SOM_CPUS = (System.getenv('NF_LOCAL_CPUS') ?: '16') as int

process {
    withName: 'DEEPSOMATIC' {
        cpus = SOM_CPUS
    }
}
