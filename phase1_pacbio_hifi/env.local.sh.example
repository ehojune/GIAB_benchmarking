# 잡 크기 오버라이드 템플릿. 쓰려면 복사해서 값만 고른다 (env.local.sh는 git 미추적):
#     cp phase1_pacbio_hifi/env.local.sh.example phase1_pacbio_hifi/env.local.sh
#
# 반드시 ${VAR:-값} 꼴을 유지할 것. env.sh가 이 파일을 먼저 읽으므로,
# 이 형태여야 `SGE_SLOTS=60 bash scripts/10_submit.sh <dsid>` 같은 1회성 지정이 이긴다.
#
# ── nbb2 실측 (2026-08-21) ────────────────────────────────────────────────
#   shepherd-1-7/8/9: 각 64코어 / 251.1 GB RAM
#   h_vmem: requestable=YES, **consumable=NO**
#
# consumable=NO가 핵심이다. SGE가 h_vmem을 예약하지 않는다 — 그냥 잡별 상한(넘으면 kill)일
# 뿐이라, 한 노드에 잡이 여러 개 붙어 RAM 합계가 251 GB를 넘어도 스케줄러가 안 막는다.
# 즉 **패킹을 통제하는 건 슬롯뿐**이다. 그래서 "슬롯 = 노드 지분"으로 잡고,
# (노드당 잡 수) x NF_LOCAL_MEM_GB < 251 이 되게 메모리를 정해야 한다.
# NF_LOCAL_MEM_GB는 Nextflow가 태스크를 동시에 띄울 때의 메모리 총량 상한이고,
# SGE_VMEM은 그보다 조금 크게 둬서 컨테이너/JVM 오버헤드를 흡수한다.
#
# ── 프리셋 (셋 중 하나만 주석 해제) ──────────────────────────────────────
# 노드를 다른 사용자(이동윤·윤예영 등)와 나눠 쓰므로 64슬롯을 다 먹지 않게 여유를 남겼다.

# [A] 노드당 2잡 = 동시 6런  ← 권장 기본값
# 60/64 슬롯, 220/251 GB 사용. 100x+ 데이터(HG008-T 116x, HG009T-p16 140x)도 안전하고
# NFS I/O 경합이 [B]보다 덜하다.
export SGE_SLOTS="${SGE_SLOTS:-30}"
export SGE_VMEM="${SGE_VMEM:-115G}"
export NF_LOCAL_MEM_GB="${NF_LOCAL_MEM_GB:-110}"

# [B] 노드당 3잡 = 동시 9런 (커밋된 기본값과 동일)
# 63/64 슬롯, 210/251 GB. 병렬 런 수가 최대라 60x 이하 데이터가 많을 때 총 처리량이 좋다.
# 고심도 데이터에서 DeepVariant가 70 GB를 넘길 수 있다.
# export SGE_SLOTS="${SGE_SLOTS:-21}"
# export SGE_VMEM="${SGE_VMEM:-78G}"
# export NF_LOCAL_MEM_GB="${NF_LOCAL_MEM_GB:-70}"

# [C] 노드당 1잡 = 동시 3런
# 런 하나를 최대한 빨리 끝내야 할 때만. 60슬롯/230 GB를 한 잡이 독점한다.
# export SGE_SLOTS="${SGE_SLOTS:-60}"
# export SGE_VMEM="${SGE_VMEM:-240G}"
# export NF_LOCAL_MEM_GB="${NF_LOCAL_MEM_GB:-230}"

# ── 그 밖에 바꿀 수 있는 것들 ────────────────────────────────────────────
# export GIAB_ROOT="${GIAB_ROOT:-/BiO/scratch/ehojune/GIAB_benchmark}"
# export RUN_BASE="${RUN_BASE:-$GIAB_ROOT/processed_data_ehojune}"
# export REF_FASTA="${REF_FASTA:-...}"   # aligned BAM 진입에서 reference가 다를 때
# export SGE_HOSTS="${SGE_HOSTS:-(shepherd-1-7|shepherd-1-8)}"   # 노드 한 대 비워둘 때
#
# octopus.q(octopus-2-1~2-11)도 쓸 수 있다 (2026-08-22 확인). 노드 스펙은 `qhost`로 먼저 볼 것 —
# 위 메모리 계산은 shepherd(64코어/251 GB) 기준이라 그대로 옮기면 안 될 수 있다.
# export SGE_QUEUE="${SGE_QUEUE:-octopus.q}"
# export SGE_HOSTS="${SGE_HOSTS:-(octopus-2-1|octopus-2-2|octopus-2-3)}"
