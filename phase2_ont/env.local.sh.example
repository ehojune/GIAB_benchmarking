# 잡 크기 오버라이드 템플릿. 쓰려면 복사해서 값만 고른다 (env.local.sh는 git 미추적):
#     cp phase2_ont/env.local.sh{.example,}
#
# 반드시 ${VAR:-값} 꼴을 유지할 것. env.sh가 이 파일을 먼저 읽으므로,
# 이 형태여야 `SGE_SLOTS=60 bash scripts/10_submit.sh <dsid>` 같은 1회성 지정이 이긴다.
#
# ── 쓸 수 있는 노드 (**고정이 아니다 — 매번 확인할 것**) ──────────────────
#   2026-08-22: shepherd-1-7/8/9 (shepherd.q) 세 대
#   2026-09-22: octopus-2-8, octopus-2-9, shepherd-1-8, shepherd-1-9 네 대 — **큐가 둘로 갈렸다**
#   전부 64코어 / 251.1 GB RAM (같은 스펙).
# 지금 뭘 쓸 수 있는지 보는 명령:  qstat -f | awk '$1 ~ /@/ {print $1}' | sort -u
# 노드가 바뀌면 아래 두 줄만 고치면 된다. 큐 x 노드가 안 겹치면 스크립트가 제출을 막는다
# (lib.sh의 *_require_sge_targets) — 안 막으면 잡이 에러 없이 qw 로 영원히 남는다.
# export SGE_QUEUE="${SGE_QUEUE:-shepherd.q,octopus.q}"
# export SGE_HOSTS="${SGE_HOSTS:-(octopus-2-8|octopus-2-9|shepherd-1-8|shepherd-1-9)}"
#
#   h_vmem: requestable=YES, **consumable=NO** → SGE가 메모리를 예약하지 않는다.
#   (2026-09-18 실측으로는 상한도 아니다 — 32G 선언 잡이 73 GB 쓰고 exit 0으로 끝났다.)
#   즉 패킹을 통제하는 건 슬롯뿐이다. (노드당 잡 수) x NF_LOCAL_MEM_GB < 251 을 직접 지켜야 한다.
#
# ── 프리셋 (하나만 주석 해제) ────────────────────────────────────────────
# ONT는 리드 길이 분포가 극단적이라(UL은 100 kb+) minimap2 정렬의 메모리·시간이 HiFi와 다르게 튄다.
# 첫 1~2런이 끝나면 `qacct -j <jobid>`의 maxvmem/ru_wallclock을 보고 여기를 조정할 것.

# [A] 노드당 2잡 = 동시 6런  ← env.sh 커밋값과 동일 (권장 기본)
# 60/64 슬롯, 220/251 GB. HG008-N-D(93x)·HG008T-p2(100x)를 감당할 여유를 둔 값이다.
export SGE_SLOTS="${SGE_SLOTS:-30}"
export SGE_VMEM="${SGE_VMEM:-115G}"
export NF_LOCAL_MEM_GB="${NF_LOCAL_MEM_GB:-110}"

# [B] 노드당 1잡 = 동시 3런
# 런 하나를 최대한 빨리 끝내야 할 때. 고심도 UL 런(HG008-N-D 93x)에서 정렬이 메모리를 크게 쓰면 이쪽.
# export SGE_SLOTS="${SGE_SLOTS:-60}"
# export SGE_VMEM="${SGE_VMEM:-240G}"
# export NF_LOCAL_MEM_GB="${NF_LOCAL_MEM_GB:-230}"

# [C] 노드당 3잡 = 동시 9런
# 저심도 런이 많을 때 총 처리량이 좋다. ONT 50x+ 에서는 minimap2/DeepVariant가 70 GB를 넘길 수 있어 권장하지 않는다.
# export SGE_SLOTS="${SGE_SLOTS:-21}"
# export SGE_VMEM="${SGE_VMEM:-78G}"
# export NF_LOCAL_MEM_GB="${NF_LOCAL_MEM_GB:-70}"

# ── 벤치마크 잡 (60_benchmark.sh / 61_benchmark_sv.sh) ───────────────────
# 위 프리셋은 파이프라인 잡(10_submit.sh) 얘기다. 벤치마크는 별도 변수를 쓴다.
# **슬롯이 곧 동시 실행 수**라는 점이 여기서도 같다 — h_vmem은 예약도 상한도 아니므로
# (노드당 동시 잡 수) x 실측 maxvmem < 251 GB 를 슬롯으로 직접 맞춰야 한다.
#
#   hap.py    실측 maxvmem 23.7~24.5 GB (R9 8런, 2026-09-18)
#   truvari   실측 maxvmem 67~73 GB (refine 포함, 같은 날)
#
# 커밋된 기본값은 BENCH_SLOTS=8 — 노드 하나에 8잡(64슬롯) x 24.5 = 196 GB. 노드를 통째로
# 벤치마크에 쓸 때의 값이다. **파이프라인 잡이 같은 노드에 있으면 그만큼 줄여야 한다.**
# 예: 노드 하나만 쓰고 그 노드에 파이프라인 잡(30슬롯, 110 GB)이 이미 있으면
# 남는 34슬롯에 BENCH_SLOTS=16 → 동시 2잡 x 24.5 = 49 GB. 합계 159/251 GB.
# export BENCH_SLOTS="${BENCH_SLOTS:-16}"
# export BENCH_VMEM="${BENCH_VMEM:-32G}"
# export BENCH_SV_SLOTS="${BENCH_SV_SLOTS:-16}"   # truvari는 73 GB까지 가므로 동시 수를 더 줄인다
# export BENCH_SV_VMEM="${BENCH_SV_VMEM:-80G}"

# ── 그 밖에 바꿀 수 있는 것들 ────────────────────────────────────────────
# export GIAB_ROOT="${GIAB_ROOT:-/BiO/scratch/ehojune/GIAB_benchmark}"
# export RUN_BASE="${RUN_BASE:-$GIAB_ROOT/processed_data_ehojune}"
# export CLAIR3_MODEL_DIR="${CLAIR3_MODEL_DIR:-...}"
