/*
 * nbb2(KOBIC) 사이트 설정 — SGE 잡 1개 안에서 local executor로 파이프라인 전체를 돌린다.
 * (계산 노드는 외부 네트워크가 없어 NXF_OFFLINE=true + 사전 캐시 전제.
 *  SGE executor로 자식 잡을 뿌리는 방식은 노드 3대 제한을 지키기 어려워 쓰지 않는다.)
 *
 * phase1의 conf/kobic.config와 같다. 다른 점은 ONT용 프로세스 시간 상한뿐이다.
 * NXF 24.10.x의 groovy config 문법 기준 (25+ strict 파서에서는 def/System.getenv가 안 된다).
 */

def LIM_CPUS = (System.getenv('NF_LOCAL_CPUS')   ?: '30') as int
def LIM_MEM  = (System.getenv('NF_LOCAL_MEM_GB') ?: '110') as int

executor {
    name   = 'local'
    cpus   = LIM_CPUS                 // NSLOTS 초과 사용 금지 (local executor는 기본으로 노드 전체 코어를 봄)
    memory = "${LIM_MEM} GB"
}

process {
    // 라벨 선언값이 잡 크기보다 크면 잘라낸다 (요청만 클램프; 실사용은 각 툴이 지킴)
    resourceLimits = [
        cpus:   LIM_CPUS,
        memory: nextflow.util.MemoryUnit.of("${LIM_MEM} GB"),
        time:   nextflow.util.Duration.of('720h'),
    ]

    // ONT WGS는 HiFi보다 오래 걸린다 (93~100x 런은 정렬만 20시간대). 상한을 넉넉히.
    withLabel: process_low    { time = 96.h  }
    withLabel: process_medium { time = 240.h }
    withLabel: process_high   { time = 480.h }
}
