/*
 * ============================================================================
 * ont-wgs — Oxford Nanopore human WGS germline pipeline
 *
 * fastq / unaligned BAM (MM+ML 보존) / aligned BAM
 *   → [minimap2 -x map-ont] aligned BAM
 *   → [Clair3 (+DeepVariant ONT_R104)] SNV+indel
 *   → [Sniffles2] SV
 *   → [LongPhase] phase + haplotag
 *   → QC (mosdepth, samtools stats, bcftools stats, whatshap stats, MultiQC)
 *
 * phase1의 pacbio-hifi-wgs를 본떠 만든 독립 파이프라인. 플러그인 0개, nf-core 템플릿 없음.
 * 컨테이너는 전부 params.container_* 로 노출된다.
 *
 *   nextflow run pipeline/ont-wgs -profile singularity \
 *     --input samplesheet.csv --fasta ref.fa --outdir results \
 *     --clair3_model r1041_e82_400bps_sup_v430
 *
 * PacBio 파이프라인과 의도적으로 다른 부분 (근거는 README.md):
 *   - pbmm2 -> minimap2 -x map-ont, pbsv -> Sniffles2 (pbsv는 PacBio 전용)
 *   - WhatsHap phase -> LongPhase (ONT 심도에서 whatshap phase는 단일 스레드로 너무 느리다.
 *     위상 QC 지표는 계속 whatshap stats로 뽑는다)
 *   - Clair3 모델을 데이터셋마다 지정해야 하고, 필요한 모델이 이미지에 없을 수 있어
 *     --clair3_model_dir 로 외부 디렉토리를 마운트할 수 있다
 *   - DeepVariant는 ONT_R104(R10.4.1 전용) 모델뿐이라 R9.4.1 데이터에서는 --skip_deepvariant
 * ============================================================================
 */

manifest {
    name            = 'ont-wgs'
    author          = 'ehojune'
    description     = 'ONT human WGS: minimap2, Clair3, DeepVariant, Sniffles2, LongPhase'
    mainScript      = 'main.nf'
    version         = '0.1.0'
    nextflowVersion = '!>=24.04.0'
}

params {
    // ---- required ----
    input                 = null      // samplesheet CSV: sample,dataset,input_type,file[,index][,unit]
    fasta                 = null      // reference FASTA (uncompressed)
    outdir                = 'results'

    // ---- output layout ----
    // results/<sample>/<platform_subdir>/<dataset>/{02_alignedBAM,03_VCF,04_QC}
    platform_subdir       = 'ONT'
    ref_name              = null      // 산출 파일명에 쓰인다. 기본값 = fasta basename
    run_label             = 'run'     // multiqc/ 와 pipeline_info/ 를 네임스페이스 분리 —
                                      // 여러 런이 하나의 --outdir을 공유해도 리포트가 안 덮인다

    // ---- step toggles ----
    skip_deepvariant      = false     // R9.4.1 데이터에서는 반드시 true (ONT_R104는 R10.4.1 모델)
    skip_clair3           = false
    skip_sniffles         = false
    skip_phasing          = false     // LongPhase phase + haplotag
    skip_qc               = false
    gvcf                  = false     // DeepVariant gVCF도 출력

    // ---- minimap2 ----
    minimap2_preset       = 'map-ont'
    minimap2_args         = '-Y'      // -Y: supplementary를 soft-clip으로 (SV 콜러가 clip 서열을 읽게).
                                      //     MM/ML 보존용 -y는 uBAM 진입에서만 자동으로 붙는다 (main.nf 참고)
    minimap2_sort_mem     = '2G'      // samtools sort -m (스레드당). 스레드 수 x 이 값이 정렬 메모리다
    ubam_tags             = 'MM,ML,MN'   // samtools fastq -T. 없는 태그는 조용히 무시된다

    // ---- Clair3 ----
    clair3_platform       = 'ont'
    clair3_model          = 'r1041_e82_400bps_sup_v500'
                                      // 데이터셋마다 다르다. 틀려도 조용히 돌아간다.
                                      // R9.4.1 Guppy3~4  : r941_prom_hac_g360+g422   (이미지에 없음 -> model_dir)
                                      // R10.4.1 sup@v4.2 : r1041_e82_400bps_sup_v420 (이미지에 없음 -> model_dir)
                                      // R10.4.1 sup@v4.3 : r1041_e82_400bps_sup_v430 (이미지에 없음 -> model_dir)
                                      // R10.4.1 sup@v5.0 : r1041_e82_400bps_sup_v500 (이미지에 있음)
    clair3_model_dir      = null      // 외부 모델 디렉토리. 주면 여기서 먼저 찾고 없으면 /opt/models
    clair3_args           = ''        // 예: '--include_all_ctgs'

    // ---- DeepVariant ----
    deepvariant_model     = 'ONT_R104'   // 1.10.0의 ONT 모델은 이것뿐 (R10.4.1 전용)
    deepvariant_args      = ''

    // ---- Sniffles2 ----
    sniffles_tandem_repeats = null    // TRF bed (권장). pbsv 배포본과 동일 파일
    sniffles_args           = ''

    // ---- LongPhase ----
    phase_vcf             = 'clair3'  // 위상을 매길 소변이 VCF: clair3 | deepvariant
    phase_sv              = true      // Sniffles2 VCF도 같이 위상 (--sv-file)
    longphase_args        = ''

    // ---- SGE (-profile sge 에서만 쓰인다) ----
    sge_queue             = null
    sge_pe                = 'smp'
    sge_options           = ''

    // ---- containers ----
    // 태그는 2026-08-22에 quay.io / Docker Hub / seqera wave 레지스트리로 확인했다.
    container_minimap2    = 'community.wave.seqera.io/library/minimap2_samtools:b09096fc890429ce'
                                      // minimap2 2.30 + samtools 1.23.1 (nf-core minimap2/align이 쓰는 이미지).
                                      // 정렬이 samtools fastq | minimap2 | samtools sort 파이프라 한 이미지에 둘 다 있어야 한다.
    container_samtools    = 'quay.io/biocontainers/samtools:1.24--h9dcdb79_1'
    container_bcftools    = 'quay.io/biocontainers/bcftools:1.24--h118bc1c_2'
    container_sniffles    = 'quay.io/biocontainers/sniffles:2.8.0--pyhdfd78af_1'
    container_longphase   = 'quay.io/biocontainers/longphase:2.0.2--h4e109e1_0'
    container_whatshap    = 'quay.io/biocontainers/whatshap:2.8--py312hf731ba3_0'    // stats 전용
    container_mosdepth    = 'quay.io/biocontainers/mosdepth:0.3.14--h05c3d44_1'
    container_multiqc     = 'quay.io/biocontainers/multiqc:1.35--pyhdfd78af_1'
    container_deepvariant = 'google/deepvariant:1.10.0'
    container_clair3      = 'hkubal/clair3:v1.2.0'
                                      // v2.x는 HiFi 모델을 전부 뺐다(phase1에서 확인). ONT 모델도 버전마다
                                      // 갈리므로 이미지 안 /opt/models 목록을 01_prepare에서 찍어 확인한다.
}

// ---------------------------------------------------------------------------
// Process resources (단일 노드 기준. 잡 크기 클램프는 conf/kobic.config)
// ---------------------------------------------------------------------------
process {
    // pipefail이 없으면 `samtools fastq | minimap2 | samtools sort` 에서 앞쪽이 죽어도
    // 마지막 명령의 종료 코드만 보고 성공으로 판정한다 (= 잘린 BAM이 조용히 통과).
    // Nextflow 기본은 `bash -ue` 라서 pipefail이 빠져 있다.
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Integer.MAX_VALUE: SGE h_vmem/h_rss kill이 exit code보다 먼저 wrapper를 죽이면
    // Nextflow는 "terminated for an unknown reason"으로 본다
    errorStrategy = { (task.exitStatus in [137, 140, 143, 104, 134, 139] || task.exitStatus == Integer.MAX_VALUE) ? 'retry' : 'finish' }
    maxRetries    = 1

    cpus   = 1
    memory = 2.GB
    time   = 4.h

    withLabel: process_low {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = 8.h
    }
    withLabel: process_medium {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = 48.h
    }
    withLabel: process_high {
        cpus   = 16
        memory = { 48.GB * task.attempt }
        time   = 240.h
    }

    // UL 리드(100 kb+)는 minimap2 체이닝 메모리가 리드 길이에 민감하고,
    // 여기에 samtools sort (-m minimap2_sort_mem x 스레드)가 더해진다.
    withName: MINIMAP2_ALIGN {
        memory = { 72.GB * task.attempt }
    }
    withName: SNIFFLES {
        memory = { 16.GB * task.attempt }
    }
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
profiles {

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        // 오프라인 클러스터: 이미지를 미리 pull하고 NXF_SINGULARITY_CACHEDIR을 지정한다.
    }

    sge {
        process.executor       = 'sge'
        process.penv           = params.sge_pe
        process.queue          = params.sge_queue
        process.clusterOptions = params.sge_options
    }

    // 기계적 스모크 테스트: -stub 실행 (컨테이너·데이터 없이 채널 배선만 검증)
    test {
        params.input    = "${projectDir}/assets/samplesheet.test.csv"
        params.fasta    = "${projectDir}/assets/tiny.fasta"
        params.ref_name = 'test'
    }
}

// ---------------------------------------------------------------------------
// Run reports
// ---------------------------------------------------------------------------
def trace_ts = new java.util.Date().format('yyyyMMdd-HHmmss')

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/${params.run_label}-timeline-${trace_ts}.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/${params.run_label}-report-${trace_ts}.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/${params.run_label}-trace-${trace_ts}.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/${params.run_label}-dag-${trace_ts}.html"
    overwrite = true
}
