logs/
~$*.xlsx

# 개인 오버라이드 (각 phase의 env.sh가 읽음)
phase1_pacbio_hifi/env.local.sh
phase2_ont/env.local.sh

# Nextflow 실행 부산물 — repo 루트에서 nextflow를 돌리면 생긴다.
# phase1 잡은 -wd $INFRA/launch/<dsid> 에서 돌므로 여기 것은 전부 옛 테스트 잔재다.
# .nextflow/cache 는 LevelDB(LOCK·MANIFEST 포함)라 절대 커밋하면 안 된다.
.nextflow/
.nextflow.log*
results/
work/

# python 바이트코드 (스크립트를 py_compile 로 검사하면 생긴다)
__pycache__/
*.pyc

# 벤치마크 --collect 산출물. 서버에서 언제든 재생성되고(수 초), 실측값의 정본은
# docs/reference/ 의 날짜별 기록이다. 두 세션이 서버에서 미추적으로 들고 있던 것들.
phase1_bench_summary.tsv
phase*/phase*_bench_summary.tsv
phase*/phase*_bench_sv_summary.tsv
# truth 판·층화별 산출 (60_benchmark.sh BENCH_TRUTH_VER=v5.0q --collect / --collect-strata)
phase*/phase*_bench_*.tsv
phase*/phase*_bench_strat_summary.tsv

# 리뷰 스크립트의 --tsv / TSV= 산출물 (35_review_qc.py, 62_tstv_regions.sh)
qc_review_ont.tsv
qc_review.tsv
tstv_regions.tsv

# 편집 중 백업
*.bak
